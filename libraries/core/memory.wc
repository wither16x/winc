pub void *mem_copy(void *restrict dest, const void *restrict src, usize n) {
    u8 *pdest = dest;
    const u8 *psrc = src;

    for usize i = 0; i < n; i++ {
        pdest[i] = psrc[i];
    }

    return dest;
}

pub void *mem_set(void *s, int c, usize n) {
    u8 *p = s;

    for usize i = 0; i < n; i++ {
        p[i] = (u8)c;
    }

    return s;
}

pub void *mem_move(void *dest, const void *src, usize n) {
    u8 *pdest = dest;
    const u8 *psrc = src;

    if (u64)src > (u64)dest {
        for usize i = 0; i < n; i++ {
            pdest[i] = psrc[i];
        }
    } else if (u64)src < (u64)dest {
        for usize i = n; i > 0; i-- {
            pdest[i-1] = psrc[i-1];
        }
    }

    return dest;
}

pub int mem_compare(const void *s1, const void *s2, usize n) {
    const u8 *p1 = s1;
    const u8 *p2 = s2;

    for usize i = 0; i < n; i++ {
        if p1[i] != p2[i] {
            return p1[i] < p2[i] ? -1 : 1;
        }
    }

    return 0;
}