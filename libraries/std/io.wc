import "std.sys.write";
import "std.sys.fd";
import "std.variadic";
import "std.cstring";

const char *VPRINT_NULL = "(null)";
const char *VPRINT_UNSUPPORTED = "(unsupported)";

void print_string(const char *str) {
    if !str {
        write(FD_STDOUT, VPRINT_NULL, cstr_len(VPRINT_NULL));
    } else {
        write(FD_STDOUT, str, cstr_len(str));
    }
}

pub void vprint(const char *fmt, va_list args) {
    for usize i = 0; fmt[i] != '\0'; i++ {
        if fmt[i] != '%' {
            write(FD_STDOUT, &fmt[i], 1);
            continue;
        }

        ++i;
        switch fmt[i] {
        case 's': {
            const char *s = (const char *)va_arg_ptr(args);
            print_string(s);
            break;
        }

        case 'c': {
            char ch = (char)va_arg_char(args);
            write(FD_STDOUT, &ch, 1);
            break;
        }

        default: {
            write(FD_STDOUT, VPRINT_UNSUPPORTED, cstr_len(VPRINT_UNSUPPORTED));
            break;
        }
        }
    }
}

pub void print(const char *fmt, ...) {
    va_list args;
    va_start(args, __va_area__);
    vprint(fmt, args);
    va_end(args);
}

pub void println(const char *fmt, ...) {
    va_list args;
    va_start(args, __va_area__);
    vprint(fmt, args);
    write(FD_STDOUT, "\n", 1);
    va_end(args);
}