// person.wc

#include <stdlib.h>
#include <string.h>

pub import "modules.person_struct";

pub struct person *create_person(const char *name, unsigned int age) {
    struct person *p = calloc(1, sizeof(*p));
    if !p
        return NULL;

    strncpy(p->name, name, strlen(name));
    p->age = age;
    return p;
}

pub void kill_person(struct person *p) {
    free(p);
}